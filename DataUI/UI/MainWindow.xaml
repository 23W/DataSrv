<ui:FluentWindow x:Class="DataUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataUI.UI.ViewModels"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Data UI"
        Height="450"
        Width="800"
        ExtendsContentIntoTitleBar="True"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <d:ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Theme/Light.xaml" />
                <d:ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Wpf.Ui.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:MainWindowViewModel x:Key="ViewModel"/>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid DataContext="{StaticResource ViewModel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Data UI"
                     Grid.Row="0"/>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Samples, Mode=OneWay}"
                 d:ItemsSource="{d:SampleData ItemCount=5}"/>

        <ui:Button Grid.Row="2"
                   x:Name="CloseBtn"
                   Appearance="Primary"
                   Content="Close"
                   HorizontalAlignment="Right"
                   Margin="5,5,5,5"
                   Click="OnClose"/>
    </Grid>
</ui:FluentWindow>
